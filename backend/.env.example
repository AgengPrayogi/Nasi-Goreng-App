NODE_ENV=development
PORT=5000

# MongoDB — use a replica set URI for transactions (order completion). See docs/API.md.
MONGODB_URI=mongodb://127.0.0.1:27017/nasi_goreng_polonia?replicaSet=rs0&directConnection=true
# Optional connection tuning (milliseconds)
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# HS256 secret for admin JWT (min 32 random bytes recommended for production)
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the API (required in production)
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email delivery. Configure SMTP before production; mock mode is development/test only.
EMAIL_SERVICE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# After the first admin exists, POST /api/auth/register-admin returns 403 unless true (dev/staging only)
ALLOW_ADMIN_REGISTER=false

# Shared secret for payment webhooks; required when NODE_ENV=production.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Meta WhatsApp Cloud API. Set Graph API version to a version currently supported by your Meta app.
# Keep access tokens and app secrets in deployment secrets, never in source control.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_WORKER_INTERVAL_MS=5000
WHATSAPP_REQUEST_TIMEOUT_MS=10000
WHATSAPP_MAX_ATTEMPTS=5
WHATSAPP_RETRY_BASE_MS=5000
WHATSAPP_RETRY_MAX_MS=900000

# Optional n8n self-hosted integration. Backend sends verified inbound/status events to this production webhook.
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WHATSAPP_WEBHOOK_TOKEN=
N8N_WEBHOOK_TIMEOUT_MS=10000
N8N_WEBHOOK_MAX_ATTEMPTS=8
# n8n uses this API key to ask the backend to queue allowlisted, consent-checked templates.
N8N_WHATSAPP_API_KEY=

# Queue "day" and ETA (optional overrides). See docs/API.md.
ORDER_BUSINESS_TZ=Asia/Jakarta
ETA_BASE_MINUTES=5
ETA_MINUTES_PER_ITEM=3
ETA_MINUTES_PER_ORDER_AHEAD=5

# Reservation slot buffer in minutes, applied before and after each booking
RESERVATION_BUFFER_MINUTES=15
# Upcoming reservation hold horizon for immediate walk-in dine-in orders
RESERVATION_WALKIN_HOLD_MINUTES=90

# Production must block completion/income recording until payment is marked paid.
REQUIRE_PAID_BEFORE_COMPLETE=true
